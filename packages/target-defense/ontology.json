{
  "ontology": "xunia-target-shield",
  "version": "1.1.0",
  "description": "Operational data-protection ontology for GPT-DOUG POCKET, CyberStrike, Target Shield, protected data, authorization, lineage, evidence, and defensive actions.",
  "objectTypes": {
    "Runtime": {"key":"id","required":["id","kind","location","status"],"properties":["kind","location","status","transport","metadata"]},
    "Model": {"key":"id","required":["id","providerId","runtimeId","status"],"properties":["providerId","runtimeId","status","contextWindow","capabilities"]},
    "Provider": {"key":"id","required":["id","name","api","status"],"properties":["name","api","status","authType","local"]},
    "Target": {"key":"id","required":["id","name","kind","locator","owner","environment","status"],"properties":["name","kind","locator","owner","environment","criticality","exposure","confidence","impact","status","tags"]},
    "AuthorizationLease": {"key":"id","required":["id","targetId","owner","approvedBy","scope","validFrom","validUntil","status"],"properties":["targetId","owner","approvedBy","scope","reason","validFrom","validUntil","status"]},
    "DataProtectionPolicy": {"key":"id","required":["id","name","version","defaultClassification","defaultEgress"],"properties":["name","version","defaultClassification","defaultEgress","localProcessingOnlyFor","requirePrivatePermissionsFor","forbiddenGraphKeys","allowedLocalTransports","retention"]},
    "DataAsset": {"key":"id","required":["id","name","classification","owner","purpose","residency","egress"],"properties":["name","path","classification","owner","purpose","residency","egress","retention","encryptionRequired","privatePermissionsRequired","permissionState","status"]},
    "Processor": {"key":"id","required":["id","name","local","classifications"],"properties":["name","transport","local","classifications","status"]},
    "DataFlow": {"key":"id","required":["id","dataAssetId","processorId","decision"],"properties":["dataAssetId","processorId","purpose","decision","reason","createdAt"]},
    "Finding": {"key":"id","required":["id","targetId","severity","status"],"properties":["targetId","severity","status","title","description","confidence","source","createdAt"]},
    "Evidence": {"key":"id","required":["id","targetId","kind","uri","createdAt"],"properties":["targetId","findingId","kind","uri","hash","createdAt","metadata"]},
    "DefensiveAction": {"key":"id","required":["id","targetId","action","decision","createdAt"],"properties":["targetId","authorizationLeaseId","action","decision","reason","createdAt","completedAt"]},
    "AuditEvent": {"key":"id","required":["id","timestamp","action","decision"],"properties":["targetId","actor","action","decision","reason","timestamp"]}
  },
  "linkTypes": {
    "RUNS_ON":{"from":"Model","to":"Runtime","cardinality":"many-to-one"},
    "EXPOSED_BY":{"from":"Model","to":"Provider","cardinality":"many-to-one"},
    "AUTHORIZES":{"from":"AuthorizationLease","to":"Target","cardinality":"many-to-one"},
    "PROTECTED_BY":{"from":"DataAsset","to":"DataProtectionPolicy","cardinality":"many-to-one"},
    "PROCESSED_BY":{"from":"DataAsset","to":"Processor","cardinality":"many-to-many"},
    "FLOW_GOVERNED_BY":{"from":"DataFlow","to":"DataProtectionPolicy","cardinality":"many-to-one"},
    "FLOW_USES":{"from":"DataFlow","to":"DataAsset","cardinality":"many-to-one"},
    "FLOW_TO":{"from":"DataFlow","to":"Processor","cardinality":"many-to-one"},
    "HAS_FINDING":{"from":"Target","to":"Finding","cardinality":"one-to-many"},
    "SUPPORTED_BY":{"from":"Finding","to":"Evidence","cardinality":"one-to-many"},
    "ACTS_ON":{"from":"DefensiveAction","to":"Target","cardinality":"many-to-one"},
    "GOVERNED_BY":{"from":"DefensiveAction","to":"AuthorizationLease","cardinality":"many-to-one"},
    "RECORDED_AS":{"from":"DefensiveAction","to":"AuditEvent","cardinality":"one-to-many"}
  },
  "actionTypes": {
    "Observe":{"requiresAuthorization":false,"class":"passive"},
    "PreserveEvidence":{"requiresAuthorization":false,"class":"passive"},
    "Scan":{"requiresAuthorization":true,"class":"active-validation"},
    "Probe":{"requiresAuthorization":true,"class":"active-validation"},
    "Contain":{"requiresAuthorization":true,"class":"defensive-response"},
    "Isolate":{"requiresAuthorization":true,"class":"defensive-response"},
    "Block":{"requiresAuthorization":true,"class":"defensive-response"},
    "RotateCredentials":{"requiresAuthorization":true,"class":"defensive-response"},
    "DisableOwnedService":{"requiresAuthorization":true,"class":"defensive-response"},
    "Restore":{"requiresAuthorization":true,"class":"recovery"},
    "InternalSinkhole":{"requiresAuthorization":true,"class":"defensive-response","environments":["local","lab"]}
  },
  "invariants": [
    "Active actions fail closed without an active AuthorizationLease.",
    "AuthorizationLease.owner must equal Target.owner.",
    "Target.locator must match at least one AuthorizationLease.scope entry for active actions.",
    "AuthorizationLease.validUntil must be after validFrom and no more than 168 hours later.",
    "Automatic execution is restricted to Target.environment in {local, lab}.",
    "Every protected DataAsset must be linked to a DataProtectionPolicy.",
    "CONFIDENTIAL and RESTRICTED data may only be processed by approved local processors unless explicitly reclassified and approved.",
    "Default data egress is DENY.",
    "Sensitive state files must not be group/world accessible.",
    "Secrets, tokens, passwords, API keys, and private keys must never be serialized into the ontology graph.",
    "Every allowed DataFlow must identify purpose, protected data, processor, and governing policy.",
    "Every denied DataFlow fails RedButton preflight.",
    "External hack-back or third-party retaliation is not represented as an action type."
  ]
}
